# ─────────────────────────────────────────────────────────────────────────────
# 로컬 개발 환경 변수
#
#   cp .env.example .env
#
# .env 는 .gitignore 에 있다. 절대 커밋하지 않는다.
#
# ★ DB_PASSWORD 와 CLAIMS_ENCRYPTION_KEY 에는 기본값이 없다.
#   설정하지 않으면 애플리케이션이 기동에 실패한다. 의도된 동작이다 —
#   설정 누락이 조용히 넘어가는 것보다 시끄럽게 실패하는 편이 안전하다.
# ─────────────────────────────────────────────────────────────────────────────

# ── 필수 ─────────────────────────────────────────────────────────────────────
DB_PASSWORD=localdev
CLAIMS_ENCRYPTION_KEY=local-dev-key-do-not-use-in-production

# ── 선택 (기본값 있음) ────────────────────────────────────────────────────────
SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/claims
DB_USERNAME=claims
DB_POOL_SIZE=10

REDIS_HOST=localhost
REDIS_PORT=6379

KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP=claims-platform

# business-support (계약 스냅샷 제공). 8081 포트로 뜬다.
POLICY_SERVICE_URL=http://localhost:8081

# 심사 룰셋 버전. 과거 청구는 당시 버전으로 재현되어야 하므로 함부로 올리지 않는다.
RULESET_VERSION=2026.01

# 이 금액을 넘으면 자동 승인하지 않고 심사자에게 회부한다 (R-RTE-010)
AUTO_APPROVE_THRESHOLD_WON=1000000

LOG_LEVEL=DEBUG
